# URI principal del backend. Usa una URI real solo en tu .env local no versionado.
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=budget_maker

# Credenciales del MongoDB local autenticado usado por Docker Compose.
# Docker Compose interpola este valor dentro de una URI Mongo.
# Para este stack local usa una contraseña alfanumérica sin caracteres reservados de URI.
MONGO_LOCAL_ROOT_USERNAME=bm_local_admin
MONGO_LOCAL_ROOT_PASSWORD=cambia-esta-clave-local

# URI de referencia para ejecutar la API dentro del stack Docker local.
# MONGO_URI=mongodb://bm_local_admin:cambia-esta-clave-local@mongodb:27017/budget_maker?authSource=admin

# URI exclusiva para pruebas locales. Nunca debe apuntar a Atlas.
TEST_MONGO_URI=mongodb://bm_local_admin:cambia-esta-clave-local@localhost:27017/budget_maker_test?authSource=admin

APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOWED_ORIGINS=https://budget-maker-frontend.vercel.app,http://localhost:3000,http://localhost:3001

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

UPLOAD_DIR=uploads/products
BRANDING_DIR=uploads/branding
MAX_IMAGE_SIZE_MB=2

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin1234
DEFAULT_ADMIN_EMAIL=admin@budgetmaker.local
